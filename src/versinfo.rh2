// defines for SALAMAND.EXE and ENGLISH.SLG VERSIONINFO
// look at shared\versinfo.rc

// WARNING: cannot be replaced by "#pragma once" because it is included from .rc file and it seems resource compiler does not support "#pragma once"
#ifndef __VERSINFO_RH2
#define __VERSINFO_RH2

#if defined(APSTUDIO_INVOKED) && !defined(APSTUDIO_READONLY_SYMBOLS)
#error this file is not editable by Microsoft Visual C++
#endif //defined(APSTUDIO_INVOKED) && !defined(APSTUDIO_READONLY_SYMBOLS)

#include "plugins\shared\spl_vers.h" // Extract version and build numbers.

// NerdOne Commander product version (see NERDONE_VERSION_* in spl_vers.h); nerdone.exe and
// english.slg must have identical FileVersion (checked in IsSLGFileValid), so both use these.
// The plugin API version (VERSINFO_SALAMANDER_*, LAST_VERSION_OF_SALAMANDER) is not affected.
#define VERSINFO_MAJOR       NERDONE_VERSION_MAJOR
#define VERSINFO_MINORA      NERDONE_VERSION_MINOR
#define VERSINFO_MINORB      NERDONE_VERSION_PATCH
#define VERSINFO_VERSION     NERDONE_VERSION_TEXT VERSINFO_BETAVERSION_TXT

#define VERSINFO_COPYRIGHT   "Copyright © 1997-2023 Open Salamander Authors"
#define VERSINFO_COMPANY     "NerdOne Commander"

#define VERSINFO_DESCRIPTION "NerdOne Commander, File Manager"
#define VERSINFO_COMMENT     "A small and fast two-pane file manager with open plugin architecture."

#ifdef _LANG
#define VERSINFO_INTERNAL    "ENGLISH"
#define VERSINFO_ORIGINAL    VERSINFO_INTERNAL ".SLG"
#else
#define VERSINFO_INTERNAL    "NERDONE"
#define VERSINFO_ORIGINAL    VERSINFO_INTERNAL ".EXE"
#endif

// for SLG translators
#define VERSINFO_SLG_WEB     "github.com/robertskiba/NerdOne-Commander"
#define VERSINFO_SLG_COMMENT "English version"

#endif // __VERSINFO_RH2
